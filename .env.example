# Адрес проверяемого сайта. Если оставить пустым, Jenkins запросит его перед тестом.
# Пример: https://example.ru
TARGET_URL=

# Учётная запись локального администратора Jenkins.
# Обязательно смените пароль, если Jenkins будет доступен не только с этого компьютера.
JENKINS_ADMIN_USERNAME=admin
JENKINS_ADMIN_PASSWORD=admin

# Репозиторий, ветка и путь к Jenkinsfile для автоматически создаваемого Pipeline.
JENKINSFILE_REPOSITORY=https://github.com/eldar-safin/campus-tester.git
JENKINSFILE_BRANCH=main
JENKINSFILE_PATH=Jenkinsfile
